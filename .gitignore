# Ignoruj lokálne dáta z Postgresu a Redis-u, ak ich mountuješ do priečinka
/.docker/data
/postgres_data/
/redis_data/
/mysql_data/

# --- DOPLNENÉ PRE LARAVEL ŠTRUKTÚRU ---
# Ignoruj vygenerované súbory vo frameworku, ale nechaj štruktúru
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
!storage/framework/cache/data/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/testing/.gitignore
!storage/framework/views/.gitignore
!storage/logs/.gitignore

# deptrac's AST cache, tens of MB and rebuilt on demand. The depfiles point it
# at storage/framework/cache (already ignored there); this is the tool's own
# default name, which an ad-hoc run without -c would drop here.
/.deptrac.cache

# Python bytecode from the ratchet scripts in scripts/
__pycache__/

# --- OSTATNÉ ---
.env.testing
/dist
/vendor_bin
/.htaccess
/.continue/new-mcp-server.yaml
