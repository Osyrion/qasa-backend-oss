{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "zoad/zoad-core",
    "type": "project",
    "description": "Zoad Core \u2014 open-source invoicing and CRM API for freelancers (Laravel)",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.5",
        "ext-dom": "*",
        "ext-iconv": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*",
        "barryvdh/laravel-dompdf": "^3.1",
        "brick/math": "^0.18",
        "chillerlan/php-qrcode": "^6.0",
        "laravel/framework": "^13.0",
        "laravel/mcp": "^0.7.2",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.26",
        "laravel/tinker": "^3.0",
        "league/csv": "^9.28",
        "league/flysystem-aws-s3-v3": "^3.25",
        "pragmarx/google2fa": "^8.0",
        "sentry/sentry-laravel": "^4.27",
        "smalot/pdfparser": "^2.12",
        "spatie/laravel-data": "^4.21",
        "symfony/http-client": "^8.1",
        "symfony/postmark-mailer": "^8.1",
        "thiagoalessio/tesseract_ocr": "^2.13"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.2",
        "barryvdh/laravel-ide-helper": "^3.7",
        "darkaonline/l5-swagger": "^11.0",
        "deptrac/deptrac": "^4.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.9",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "laravel/telescope": "^5.20",
        "league/commonmark": "^2.8",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-faker": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.3.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"preg_match('/^APP_KEY=.+/m', @file_get_contents('.env')) || passthru(PHP_BINARY . ' artisan key:generate --ansi');\"",
            "@php artisan migrate --force"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "phpstan": "phpstan analyse --memory-limit=768M",
        "deptrac": [
            "deptrac analyse --config-file=deptrac.layers.php --no-progress",
            "deptrac analyse --config-file=deptrac.modules.php --no-progress"
        ],
        "deptrac:prune": "python3 scripts/deptrac-prune.py",
        "deptrac:baseline": [
            "deptrac analyse --config-file=deptrac.layers.php --no-progress --formatter=baseline --output=deptrac.layers.baseline.yaml || true",
            "deptrac analyse --config-file=deptrac.modules.php --no-progress --formatter=baseline --output=deptrac.modules.baseline.yaml || true",
            "echo 'Baselines rewritten. They may only ever shrink: update deptrac.baseline.counts.json to match (the failing test names both numbers), and expect the deptrac-ratchet CI job to reject any entry main did not already have.'"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": [
                "PKSA-m5cs-t1y6-qpcs",
                "PKSA-93qv-9n9h-6k6p",
                "PKSA-k22t-f949-t9g6",
                "PKSA-432p-hv1d-chf7",
                "PKSA-y6py-qpv1-h52p",
                "PKSA-bf7t-jnpz-492k",
                "PKSA-7qs6-zvnz-h66r"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
